# ============================================================
# LocalHub 云端后端 · 环境变量模板
# 复制为 .env 并填写真实值。.env 不要提交到 Git。
# Supabase 项目 ref: grutfwvthmrdhywwwlyw（已填入）
# [YOUR-PASSWORD] 需替换为你的 Supabase 数据库密码
# ============================================================

# ---- Supabase PostgreSQL ----
# transaction-mode pooler（运行时连接，IPv4-only）
DATABASE_URL="postgresql://postgres.grutfwvthmrdhywwwlyw:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# session-mode pooler（Prisma 迁移用）
DIRECT_URL="postgresql://postgres.grutfwvthmrdhywwwlyw:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# ---- 应用 ----
PORT=3000
HOST=127.0.0.1

# 首次启动默认密码（首次运行会写入 settings 表）
LH_PASSWORD="1607570960qqQ"

# JWT / 令牌种子（用于生成会话 token，建议随机长字符串）
JWT_SECRET="please-change-me-to-a-long-random-secret"

# ---- GitHub OAuth 登录（可选，未配置则前端隐藏 GitHub 按钮） ----
# 在 https://github.com/settings/applications 创建 OAuth App 获得
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# 回调地址（需与 GitHub OAuth App 的 Authorization callback URL 一致），例：
# https://lxlrwxs.top/api/auth/github/callback
GITHUB_REDIRECT_URI=""
# 登录成功后前端跳转地址（默认 /）
GITHUB_FRONTEND_URL="/"

# ---- 邮箱验证码（可选，未配置则注册时跳过验证码校验） ----
# 以 QQ 邮箱为例：SMTP_HOST=smtp.qq.com，端口 465，SMTP_PASS 为 QQ 邮箱授权码（非登录密码）
SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="LocalHub <你的邮箱>"

# ---- 静态资源目录 ----
# 前端构建产物与排行榜静态目录（默认指向 ../web/dist 与 ../web/dist/lb）
FRONTEND_DIR=""
LB_DIR=""
BLOG_DIR=""